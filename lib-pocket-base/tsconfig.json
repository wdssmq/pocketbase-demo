{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "declaration": true,
    // "declarationDir": "dist/types",
    // "sourceMap": true,
    "rootDir": "./src/lib-core",
    "outDir": "./dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    // "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    // "skipLibCheck": true,
    "allowJs": false
  },
  "include": ["src/lib-core/*.ts"],
  "exclude": ["dist", "dist-test", "node_modules"]
}
